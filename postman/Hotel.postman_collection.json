{
  "info": {
    "name": "Гостиница — проверки API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Проверки текущего API поиска свободных номеров на исходных данных data.sql. API не выполняет заселение."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Бюджет 200: 10 номеров",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/bookings?money=200"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON content type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Состав, бюджет и сортировка\", () => {",
              " const rooms = pm.response.json();",
              " pm.expect(rooms).to.be.an(\"array\").with.lengthOf(10);",
              " pm.expect(rooms.map(r => r.number).sort((a,b)=>a-b)).to.eql(Array.from({length:10},(_,i)=>i+1));",
              " rooms.forEach((r,i) => {",
              "   pm.expect(Object.keys(r).sort()).to.eql([\"number\",\"price\",\"roomCategory\"]);",
              "   pm.expect(r.price).to.be.at.most(200);",
              "   const price = r.number <= 10 ? 200 : r.number <= 20 ? 400 : 600;",
              "   pm.expect(r.price).to.eql(price);",
              "   pm.expect(r.roomCategory).to.eql({200:\"ECONOMY\",400:\"STANDARD\",600:\"PREMIUM\"}[price]);",
              "   if(i) pm.expect(r.price).to.be.at.least(rooms[i-1].price);",
              " });",
              "});"
            ]
          }
        }
      ]
    },
